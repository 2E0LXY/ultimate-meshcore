# UMC Net: MQTT over WebSockets, behind TLS, and the dashboard behind a login. A separate site; the other
# sites are untouched. Installed as /etc/caddy/conf.d/umcnet.caddy and pulled in with one `import` line.
net.2e0lxy.uk {
	@mqtt path /mqtt /mqtt/*
	handle @mqtt {
		reverse_proxy 127.0.0.1:9101
	}
	handle {
		basic_auth {
			admin __DASH_HASH__
		}
		reverse_proxy 127.0.0.1:9102
	}
}
