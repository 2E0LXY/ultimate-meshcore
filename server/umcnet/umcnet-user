#!/usr/bin/env python3
"""Manage UMC Net accounts: passwords and topic permissions.

  umcnet-user add <name> <role> [--device <64 hex>] [--password P]   create or reset an account
  umcnet-user device <name> <64 hex>                                  set a repeater's device id
  umcnet-user remove <name>
  umcnet-user list

Roles: admin (everything), repeater (publishes what it hears, takes commands), client (listens),
viewer (listens only). The topics are the standard MeshCore MQTT layout the firmware already
publishes, so analysers and maps can read them too:

  meshcore/<area>/<device id>/raw       a packet the device heard, as JSON with the packet in hex
  meshcore/<area>/<device id>/packets   the same, decoded
  meshcore/<area>/<device id>/status    the device's retained state (online/offline)

<area> is the IATA-style code set with `set mqtt.iata`, <device id> the repeater's 64-digit public
key in capitals (shown at boot as "Repeater ID", and by `get public.key`). A repeater may only
write under its own id, and may read everyone's raw packets and status.
"""
import json, os, re, secrets, shutil, subprocess, sys

HOME = "/opt/umcnet"
USERS = os.path.join(HOME, "users.json")
PASSWD = os.path.join(HOME, "passwd")
ACL = os.path.join(HOME, "acl")
ROLES = ("admin", "repeater", "client", "viewer")
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{1,23}$")
DEVICE = re.compile(r"^[0-9A-F]{64}$")


def load():
    try:
        with open(USERS) as f:
            raw = json.load(f)
    except FileNotFoundError:
        return {}
    # the first version stored only the role as a string
    return {n: (v if isinstance(v, dict) else {"role": v}) for n, v in raw.items()}


def save(users):
    tmp = USERS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(users, f, indent=1, sort_keys=True)
    os.chmod(tmp, 0o640)
    os.replace(tmp, USERS)


def own(path):
    # the broker runs as the umcnet user and wants its files private to it
    shutil.chown(path, "umcnet", "umcnet")
    os.chmod(path, 0o600)


def acl_for(name, info):
    role, dev = info.get("role"), info.get("device", "")
    out = [f"user {name}"]
    if role == "admin":
        out.append("topic readwrite #")
    elif role == "repeater":
        if dev:
            out.append(f"topic readwrite meshcore/+/{dev}/#")
        out += ["topic read meshcore/+/+/raw",
                "topic read meshcore/+/+/status",
                f"topic read umcnet/v1/+/node/{name}/cmd",
                f"topic write umcnet/v1/+/node/{name}/resp"]
    else:   # client and viewer listen
        out += ["topic read meshcore/+/+/raw",
                "topic read meshcore/+/+/packets",
                "topic read meshcore/+/+/status"]
    return "\n".join(out)


def write_acl(users):
    body = "# generated by umcnet-user - do not edit by hand\n\n"
    body += "\n\n".join(acl_for(n, i) for n, i in sorted(users.items())) + "\n"
    tmp = ACL + ".tmp"
    with open(tmp, "w") as f:
        f.write(body)
    os.replace(tmp, ACL)
    own(ACL)


def reload_broker():
    subprocess.run(["systemctl", "reload", "umcnet-mosquitto"], check=False)


def passwd(*args):
    # run as the broker's own user so the password file stays owned by it
    subprocess.run(["runuser", "-u", "umcnet", "--", "mosquitto_passwd", *args], check=True)


def opt(argv, flag):
    return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else None


def main(argv):
    if len(argv) < 2 or argv[1] not in ("add", "remove", "list", "device"):
        print(__doc__)
        return 2
    users = load()
    if argv[1] == "list":
        for n, i in sorted(users.items()):
            dev = i.get("device", "")
            print(f"{n:24s} {i['role']:9s} {dev[:16] + '...' if dev else ''}")
        return 0
    name = argv[2] if len(argv) > 2 else ""
    if not NAME.match(name):
        print("name: 2-24 characters, lowercase letters, digits and dashes")
        return 2
    if argv[1] == "remove":
        users.pop(name, None)
        passwd("-D", PASSWD, name)
    elif argv[1] == "device":
        dev = (argv[3] if len(argv) > 3 else "").upper()
        if name not in users or users[name]["role"] != "repeater" or not DEVICE.match(dev):
            print("device: an existing repeater account and a 64-digit hex device id")
            return 2
        users[name]["device"] = dev
        print(f"{name}: device id set")
    else:
        role = argv[3] if len(argv) > 3 else ""
        if role not in ROLES:
            print("role: " + ", ".join(ROLES))
            return 2
        dev = (opt(argv, "--device") or "").upper()
        if role == "repeater" and not DEVICE.match(dev):
            print("a repeater needs --device <its 64-digit hex id> so it can only write under its own topic")
            return 2
        pw = opt(argv, "--password") or secrets.token_urlsafe(15)
        if not os.path.exists(PASSWD):
            open(PASSWD, "a").close()
            own(PASSWD)
        passwd("-b", PASSWD, name, pw)
        users[name] = {"role": role, **({"device": dev} if dev else {})}
        print(f"{name} ({role}) password: {pw}")
    save(users)
    write_acl(users)
    own(PASSWD)
    reload_broker()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
