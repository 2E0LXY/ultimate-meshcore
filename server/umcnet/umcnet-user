#!/usr/bin/env python3
"""Manage UMC Net accounts: passwords and topic permissions.

  umcnet-user add <name> <role> [--password P]   create or reset an account, print its password
  umcnet-user remove <name>
  umcnet-user list

Roles: admin (everything), repeater (publishes what it hears, takes commands), client (listens,
sends through a repeater), viewer (listens only). The topic tree is umcnet/v1/<area>/...:

  bus/rx                 packets heard on RF, published by bridging repeaters, read by everyone
  node/<name>/status     a node's retained state (the node writes it)
  node/<name>/cmd        commands for a node (admin writes, the node reads)
  node/<name>/resp       a node's replies (the node writes)
  client/<name>/tx       packets a client wants sent over RF (bridging repeaters read them)
"""
import json, os, re, secrets, shutil, subprocess, sys

HOME = "/opt/umcnet"
USERS = os.path.join(HOME, "users.json")
PASSWD = os.path.join(HOME, "passwd")
ACL = os.path.join(HOME, "acl")
ROLES = ("admin", "repeater", "client", "viewer")
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{1,23}$")


def load():
    try:
        with open(USERS) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save(users):
    tmp = USERS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(users, f, indent=1, sort_keys=True)
    os.chmod(tmp, 0o640)
    os.replace(tmp, USERS)


def acl_for(name, role):
    t = "umcnet/v1/+"
    out = [f"user {name}"]
    if role == "admin":
        out.append("topic readwrite umcnet/#")
    elif role == "repeater":
        out += [f"topic readwrite {t}/bus/rx",
                f"topic read {t}/client/+/tx",
                f"topic write {t}/node/{name}/status",
                f"topic write {t}/node/{name}/resp",
                f"topic read {t}/node/{name}/cmd",
                f"topic read {t}/node/+/status"]
    elif role == "client":
        out += [f"topic read {t}/bus/rx",
                f"topic read {t}/node/+/status",
                f"topic write {t}/client/{name}/tx"]
    else:
        out += [f"topic read {t}/bus/rx", f"topic read {t}/node/+/status"]
    return "\n".join(out)


def own(path):
    # the broker runs as the umcnet user and wants its files private to it
    shutil.chown(path, "umcnet", "umcnet")
    os.chmod(path, 0o600)


def write_acl(users):
    body = "# generated by umcnet-user - do not edit by hand\n\n"
    body += "\n\n".join(acl_for(n, r) for n, r in sorted(users.items())) + "\n"
    tmp = ACL + ".tmp"
    with open(tmp, "w") as f:
        f.write(body)
    os.replace(tmp, ACL)
    own(ACL)


def reload_broker():
    subprocess.run(["systemctl", "reload", "umcnet-mosquitto"], check=False)


def main(argv):
    if len(argv) < 2 or argv[1] not in ("add", "remove", "list"):
        print(__doc__)
        return 2
    users = load()
    if argv[1] == "list":
        for n, r in sorted(users.items()):
            print(f"{n:24s} {r}")
        return 0
    name = argv[2] if len(argv) > 2 else ""
    if not NAME.match(name):
        print("name: 2-24 characters, lowercase letters, digits and dashes")
        return 2
    if argv[1] == "remove":
        users.pop(name, None)
        subprocess.run(["runuser", "-u", "umcnet", "--", "mosquitto_passwd", "-D", PASSWD, name], check=False)
    else:
        role = argv[3] if len(argv) > 3 else ""
        if role not in ROLES:
            print("role: " + ", ".join(ROLES))
            return 2
        pw = secrets.token_urlsafe(15)
        if "--password" in argv:
            pw = argv[argv.index("--password") + 1]
        if not os.path.exists(PASSWD):
            open(PASSWD, "a").close()
            own(PASSWD)
        # run as the broker's own user so the password file stays owned by it
        subprocess.run(["runuser", "-u", "umcnet", "--", "mosquitto_passwd", "-b", PASSWD, name, pw], check=True)
        users[name] = role
        print(f"{name} ({role}) password: {pw}")
    save(users)
    write_acl(users)
    own(ACL)
    reload_broker()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
